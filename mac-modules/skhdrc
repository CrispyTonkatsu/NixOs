## Yabai bindings

# focus window
ctrl + alt - h : yabai -m window --focus west || yabai -m display --focus west
ctrl + alt - j : yabai -m window --focus south || yabai -m display --focus south
ctrl + alt - k : yabai -m window --focus north || yabai -m display --focus north
ctrl + alt - l : yabai -m window --focus east || yabai -m display --focus east

# swap managed window
ctrl + alt + shift - h : yabai -m window --swap west || yabai -m window --display west --focus
ctrl + alt + shift - j : yabai -m window --swap south || yabai -m window --display south --focus
ctrl + alt + shift - k : yabai -m window --swap north || yabai -m window --display north --focus
ctrl + alt + shift - l : yabai -m window --swap east || yabai -m window --display east --focus

# toggle window zoom
ctrl + alt - m : yabai -m window --toggle zoom-parent --focus
ctrl + alt - f : yabai -m window --toggle zoom-fullscreen --focus

:: deep_settings @
ctrl + alt - w; deep_settings

# toggle window split type
deep_settings < t : yabai -m window --toggle split ; skhd -k "escape"

# float and center
deep_settings < f : yabai -m window --toggle float --grid 4:4:1:1:2:2 ; skhd -k "escape"

deep_settings < escape; default
